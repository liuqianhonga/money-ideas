<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <header class="site-header">
      <h1>💰 {{ site.title }}</h1>
      <p class="subtitle">{{ site.description }}</p>
      <nav class="site-nav">
        <a href="/">📌 最新项目</a>
        <a href="/archive/">📚 归档</a>
      </nav>
    </header>

    <main>
      {% set grouped = collections.projects | groupByDate %}
      {% for day in grouped %}
      <div class="day-group">
        <div class="date" style="color: var(--accent); font-weight: 700; margin: 24px 0 12px; font-size: 1.05rem;">
          📅 {{ day.date }} · 共 {{ day.items.length }} 个项目
        </div>
        {% for item in day.items %}
        <div class="card">
          <div class="date">{{ item.date | dateDisplay }}</div>
          <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
          <div class="badges">
            {% if item.data.category %}<span class="badge">{{ item.data.category }}</span>{% endif %}
            {% if item.data.businessModel %}<span class="badge blue">{{ item.data.businessModel }}</span>{% endif %}
            {% if item.data.feasibility >= 4 %}<span class="badge hot">🔥 可行性 {{ item.data.feasibility }}/5</span>{% else %}<span class="badge">可行性 {{ item.data.feasibility }}/5</span>{% endif %}
          </div>
          <p class="summary">{{ item.data.summary }}</p>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </main>

    <footer class="site-footer">
      <p>{{ site.title }} · 每日更新 · 所有项目均注明出处，可回溯验证</p>
    </footer>
  </div>
</body>
</html>
